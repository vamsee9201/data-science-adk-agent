APP_ENV=development
GOOGLE_APPLICATION_CREDENTIALS=.secrets/vertex-service-account.json
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.8-flash
MAX_UPLOAD_MB=25
SESSION_TTL_MINUTES=60
AGENT_TURN_TIMEOUT_SECONDS=270
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
MAX_ACTIVE_SESSIONS=25
MAX_TURNS_PER_SESSION=20
MAX_AGENT_TURNS_PER_HOUR=30
MAX_AGENT_TURNS_PER_DAY=100
MAX_CONCURRENT_AGENT_TURNS=1
MAX_MODEL_OUTPUT_TOKENS=2048
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.run.app
EXPOSE_API_DOCS=true
